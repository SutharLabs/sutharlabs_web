{
  "buildCommand": "npm install && npx prisma generate && npm run build:server && vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/server.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/server?apiPath=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
