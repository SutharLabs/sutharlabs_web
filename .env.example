# ==============================================================================
# SutharLabs Environment Variables Template
# ==============================================================================

# 1. Google OAuth Authentication
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# 2. Dual-Tier Database Architecture
# Primary: Oracle Cloud VM PostgreSQL 16
DATABASE_URL="postgres://suthar_admin:password@137.23.61.191:5432/sutharlabs_production"
# Disaster Recovery Backup: Neon Serverless PostgreSQL
BACKUP_DATABASE_URL="postgresql://user:password@ep-super-dust.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 3. Session Security, Encryption & RBAC
JWT_SECRET="your_secure_random_jwt_secret_hex"
PLUGIN_ENCRYPTION_SECRET="your_aes_256_gcm_vault_encryption_secret"
ADMIN_EMAIL="admin@sutharlabs.com"
CRON_SECRET="your_secure_cron_trigger_secret"

# 4. Platform Domain Configuration
APP_URL="https://www.sutharlabs.com"

# 5. Vercel Blob Storage Configuration
BLOB_STORE_ID="store_id"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token"
BLOB_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# 6. Oracle Cloud Storage Vault (VM1: sutharlabs-db-store - 137.23.61.191)
ORACLE_VAULT_URL="http://137.23.61.191"
ORACLE_VAULT_SECRET="sutharlabs-vault-master-sec-2026-matrix"

# 7. Oracle Cloud AI Inference Node (VM2: sutharlabs-prod - 132.226.190.125)
ORACLE_AI_URL="http://132.226.190.125"
ORACLE_AI_SECRET="sutharlabs-matrix-ai-prod-2026"

# 8. Optional Third-Party Services
GEMINI_API_KEY="your_optional_gemini_api_key"

# 9. Dual-Mode Single-Switch Architecture (Vercel vs Oracle VM Backend Routing)
# Values: "VERCEL" (default serverless execution) | "ORACLE" (smart proxy to Oracle VM backend)
BACKEND_TARGET="VERCEL"
ORACLE_BACKEND_URL="http://132.226.190.125"
