datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// 1. Corporate Accounts
model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  name                String
  passwordHash        String?
  role                String                @default("Developer") // Admin, Developer, Banned
  mustChangePassword  Boolean               @default(false)
  joinedAt            DateTime              @default(now())
  activityCount       Int                   @default(0)
  bio                 String?
  githubHandle        String?
  company             String?
  portfolio           Portfolio?
  workspacePlugins    UserWorkspacePlugin[]
  pluginReviews       WorkspacePluginReview[]
  accountingStore     AccountingTenantStore?
}

// 2. Financial Ledgers
model Invoice {
  id      String   @id // e.g. ST-00241
  date    String
  client  String
  amount  Float
  status  String   // Paid, Pending
}

// 3. Workflow Layout Nodes
model FlowNode {
  id           String   @id
  label        String
  type         String   // source, processor, output
  status       String   @default("IDLE") // IDLE, ACTIVE, EXECUTED
  pluginActive Boolean  @default(false)
  fileUsed     String?
  x            Float
  y            Float
}

// 4. Stock Market Portfolios
model Portfolio {
  id        String   @id @default(uuid())
  userEmail String   @unique
  cash      Float    @default(10000.0)
  shares    Int      @default(0)
  buyPrice  Float    @default(0.0)
  user      User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
}

// 5. MCP Store registry (App Store)
model Plugin {
  id          String   @id @default(uuid())
  name        String
  category    String
  type        String   // Free, Premium, Trial
  downloads   String   @default("0k")
  rating      Float    @default(5.0)
  description String
  iconSymbol  String   @default("smart_toy")
  tags        String   // Serialized JSON array of tags
}

// 5b. Workspace Plugin Store registry
model WorkspacePlugin {
  id          String   @id @default(uuid())
  name        String
  category    String
  type        String   // Native, Extension, Tool
  description String
  iconSymbol  String   @default("extension")
  version     String   @default("0.1.0")
  
  installedBy UserWorkspacePlugin[]
  reviews     WorkspacePluginReview[]
  versions    WorkspacePluginVersion[]
}

// 5c. Join table for User installed Workspace Plugins
model UserWorkspacePlugin {
  id               String   @id @default(uuid())
  userEmail        String
  pluginId         String
  installedVersion String   @default("0.1.0")
  installedAt      DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  user       User             @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  plugin     WorkspacePlugin  @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  
  @@unique([userEmail, pluginId])
}

// 5d. Real User Reviews and Ratings for Workspace Plugins
model WorkspacePluginReview {
  id        String   @id @default(uuid())
  pluginId  String
  userEmail String
  userName  String   @default("Anonymous")
  rating    Int      // 1 to 5 stars
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  plugin    WorkspacePlugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([userEmail, pluginId])
}

// 5e. Immutable historical versions of plugins
model WorkspacePluginVersion {
  id               String   @id @default(uuid())
  pluginId         String
  version          String   // e.g. "0.1.0"
  changelog        String?  // Markdown summary of changes
  packageUrl       String?  // Storage URL or file path for the .zip
  checksumSha256   String?  // Cryptographic hash
  minEngineVersion String   @default("0.1.0")
  publishedBy      String   @default("System Admin")
  publishedAt      DateTime @default(now())

  plugin           WorkspacePlugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, version])
}

// 6. Immutable Auditable Trade Logs
model Trade {
  id        String   @id @default(uuid())
  userEmail String
  action    String   // BUY, SELL
  shares    Int
  price     Float
  timestamp DateTime @default(now())
}

// 7. DocNexus Document Store
model Document {
  id        String   @id @default("doc_nexus_default")
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

// 8. Development Projects Showcase
model DevelopmentProject {
  id              String   @id @default(uuid())
  title           String
  segment         String
  description     String
  detailedCase    String
  stat            String
  statLabel       String
  techs           String   // Serialized JSON array of tags
  client          String
  clientTitle     String
  blueprintSymbol String   @default("globe")
  imageSrc        String
}

// 9. Contact Inquiries & Enterprise Consultation Leads
model ContactInquiry {
  id          String   @id @default(uuid())
  trackingId  String   @unique // e.g. "SR_59281"
  name        String
  email       String
  projectType String   @default("Web Application Dev")
  message     String
  status      String   @default("New") // "New", "Contacted", "In Progress", "Closed", "Archived"
  notes       String?  // Internal admin follow-up notes
  ipAddress   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 10. Automated Paper Trading & Quantitative Trade Simulations
model SimulationStore {
  simId              String   @id @map("sim_id")
  initialCash        Float    @default(100000.0) @map("initial_cash")
  cash               Float    @default(100000.0)
  positions          String   @default("[]")
  closedTrades       String   @default("[]") @map("closed_trades")
  history            String   @default("[]")
  lastRunDate        String?  @map("last_run_date")
  totalRealizedPnL   Float    @default(0.0) @map("total_realized_pnl")
  totalFrictionPaid  Float    @default(0.0) @map("total_friction_paid")
  winCount           Int      @default(0) @map("win_count")
  lossCount          Int      @default(0) @map("loss_count")
  lastUpdated        String?  @map("last_updated")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("simulation_stores")
}

// 11. Multi-Tenant Enterprise Accounting Store
model AccountingTenantStore {
  id             String   @id @default(uuid())
  userEmail      String   @unique @map("user_email")
  companyProfile String   @default("{}") @map("company_profile") // Serialized CompanyProfile JSON
  parties        String   @default("[]") // Serialized PartyCustomer[] JSON
  items          String   @default("[]") // Serialized ItemMaster[] JSON
  invoices       String   @default("[]") // Serialized GSTInvoice[] JSON
  vouchers       String   @default("[]") // Serialized AccountingVoucher[] JSON
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user           User?    @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("accounting_tenant_stores")
}

// 12. User Bug Reports with Live Telemetry Capture
model BugReport {
  id               String   @id @default(uuid())
  trackingId       String   @unique @map("tracking_id") // e.g. "BUG-58192"
  userEmail        String   @map("user_email")
  userName         String   @default("Anonymous") @map("user_name")
  title            String
  description      String
  module           String   @default("Main Website") // "Doc Nexus", "Stock Tracker", "Accounting", "Custom Flow", etc.
  severity         String   @default("Medium") // "Low", "Medium", "High", "Critical"
  status           String   @default("New") // "New", "Investigating", "In Progress", "Resolved", "Closed"
  environment      String   @default("{}") // JSON: browser, os, screen, route, memory, userAgent
  capturedLogs     String   @default("[]") @map("captured_logs") // Serialized JSON array of telemetry breadcrumb entries
  expectedBehavior String?  @map("expected_behavior")
  actualBehavior    String?  @map("actual_behavior")
  adminNotes       String?  @map("admin_notes")
  ipAddress        String?  @map("ip_address")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("bug_reports")
}

// 13. Live Client Telemetry Logs Ingestion
model LiveTelemetryLog {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  userEmail   String?  @map("user_email")
  level       String   @default("INFO") // DEBUG, INFO, WARN, ERROR
  scope       String   @default("main") // plugin:wp_doc_nexus, main:auth, etc.
  message     String
  data        String?  // JSON context
  errorTrace  String?  @map("error_trace")
  url         String?
  timestamp   DateTime @default(now())

  @@map("live_telemetry_logs")
}

