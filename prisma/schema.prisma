datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// 1. Corporate Accounts
model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  name                String
  passwordHash        String?
  role                String                @default("Developer") // Admin, Developer, Banned
  mustChangePassword  Boolean               @default(false)
  joinedAt            DateTime              @default(now())
  activityCount       Int                   @default(0)
  portfolio           Portfolio?
  workspacePlugins    UserWorkspacePlugin[]
  pluginReviews       WorkspacePluginReview[]
}

// 2. Financial Ledgers
model Invoice {
  id      String   @id // e.g. ST-00241
  date    String
  client  String
  amount  Float
  status  String   // Paid, Pending
}

// 3. Workflow Layout Nodes
model FlowNode {
  id           String   @id
  label        String
  type         String   // source, processor, output
  status       String   @default("IDLE") // IDLE, ACTIVE, EXECUTED
  pluginActive Boolean  @default(false)
  fileUsed     String?
  x            Float
  y            Float
}

// 4. Stock Market Portfolios
model Portfolio {
  id        String   @id @default(uuid())
  userEmail String   @unique
  cash      Float    @default(10000.0)
  shares    Int      @default(0)
  buyPrice  Float    @default(0.0)
  user      User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
}

// 5. MCP Store registry (App Store)
model Plugin {
  id          String   @id @default(uuid())
  name        String
  category    String
  type        String   // Free, Premium, Trial
  downloads   String   @default("0k")
  rating      Float    @default(5.0)
  description String
  iconSymbol  String   @default("smart_toy")
  tags        String   // Serialized JSON array of tags
}

// 5b. Workspace Plugin Store registry
model WorkspacePlugin {
  id          String   @id @default(uuid())
  name        String
  category    String
  type        String   // Native, Extension, Tool
  description String
  iconSymbol  String   @default("extension")
  version     String   @default("0.1.0")
  
  installedBy UserWorkspacePlugin[]
  reviews     WorkspacePluginReview[]
  versions    WorkspacePluginVersion[]
}

// 5c. Join table for User installed Workspace Plugins
model UserWorkspacePlugin {
  id               String   @id @default(uuid())
  userEmail        String
  pluginId         String
  installedVersion String   @default("0.1.0")
  installedAt      DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  user       User             @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  plugin     WorkspacePlugin  @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  
  @@unique([userEmail, pluginId])
}

// 5d. Real User Reviews and Ratings for Workspace Plugins
model WorkspacePluginReview {
  id        String   @id @default(uuid())
  pluginId  String
  userEmail String
  userName  String   @default("Anonymous")
  rating    Int      // 1 to 5 stars
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  plugin    WorkspacePlugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([userEmail, pluginId])
}

// 5e. Immutable historical versions of plugins
model WorkspacePluginVersion {
  id               String   @id @default(uuid())
  pluginId         String
  version          String   // e.g. "0.1.0"
  changelog        String?  // Markdown summary of changes
  packageUrl       String?  // Storage URL or file path for the .zip
  checksumSha256   String?  // Cryptographic hash
  minEngineVersion String   @default("0.1.0")
  publishedBy      String   @default("System Admin")
  publishedAt      DateTime @default(now())

  plugin           WorkspacePlugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, version])
}

// 6. Immutable Auditable Trade Logs
model Trade {
  id        String   @id @default(uuid())
  userEmail String
  action    String   // BUY, SELL
  shares    Int
  price     Float
  timestamp DateTime @default(now())
}

// 7. DocNexus Document Store
model Document {
  id        String   @id @default("doc_nexus_default")
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

// 8. Development Projects Showcase
model DevelopmentProject {
  id              String   @id @default(uuid())
  title           String
  segment         String
  description     String
  detailedCase    String
  stat            String
  statLabel       String
  techs           String   // Serialized JSON array of tags
  client          String
  clientTitle     String
  blueprintSymbol String   @default("globe")
  imageSrc        String
}
